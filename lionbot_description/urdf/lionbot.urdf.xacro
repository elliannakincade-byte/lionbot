<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lionbot">

  <!-- ========================================================= -->
  <!-- LionBot measured dimensions                               -->
  <!-- All dimensions are in meters                              -->
  <!-- Coordinate convention: X forward, Y left, Z up            -->
  <!-- ========================================================= -->

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.455"/>
  <xacro:property name="chassis_width" value="0.300"/>
  <xacro:property name="ground_clearance" value="0.031"/>

  <!-- Tracks -->
  <xacro:property name="track_width" value="0.054"/>
  <xacro:property name="track_length" value="0.435"/>
  <xacro:property name="track_contact_length" value="0.360"/>
  <xacro:property name="track_separation" value="0.370"/>

  <!-- Drive system -->
  <xacro:property name="drive_sprocket_diameter" value="0.065"/>
  <xacro:property name="drive_shaft_height" value="0.050"/>
  <xacro:property name="drive_shaft_diameter" value="0.006"/>

  <!--
    Measurements intentionally NOT modeled yet:
      - Chassis/body height: needs verification
      - Exact drive joint positions: need verification
      - Encoder geometry: encoders are not currently available
      - LiDAR X/Y position: needs final verified reference point

    These will be added once verified rather than estimated.
  -->

  <!-- ========================================================= -->
  <!-- Robot reference frames                                    -->
  <!-- ========================================================= -->

  <!--
    base_footprint is the ground-level reference frame.
    It has no physical geometry.
  -->
  <link name="base_footprint"/>

  <!--
    base_link is the main body reference frame.
    Physical chassis geometry will be added once its height
    and exact vertical position have been verified.
  -->
  <link name="base_link"/>

  <!--
    Connect base_footprint to base_link.

    The measured ground clearance is currently used as the
    vertical offset. This places base_link 3.1 cm above the ground.
  -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- ros2_control hardware                                     -->
  <!-- ========================================================= -->

  <!--
    This currently declares only the Raspberry Pi-to-Arduino
    hardware connection.

    Drive joints and encoder interfaces will be added after the
    physical drive and encoder hardware are fully verified.
  -->
  <ros2_control name="LionBotSystem" type="system">
    <hardware>
      <plugin>lionbot_hardware/LionBotSystemHardware</plugin>
      <param name="serial_port">/dev/ttyACM0</param>
    </hardware>
  </ros2_control>

</robot>
