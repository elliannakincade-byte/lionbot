<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lionbot">

  <!-- ========================================================= -->
  <!-- LionBot measured dimensions                               -->
  <!-- All dimensions are in meters                              -->
  <!-- Coordinate convention: X forward, Y left, Z up            -->
  <!-- ========================================================= -->

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.455"/>
  <xacro:property name="chassis_width" value="0.300"/>
  <xacro:property name="ground_clearance" value="0.031"/>

  <!-- Tracks -->
  <xacro:property name="track_width" value="0.054"/>
  <xacro:property name="track_length" value="0.435"/>
  <xacro:property name="track_contact_length" value="0.360"/>
  <xacro:property name="track_separation" value="0.370"/>

  <!-- Drive system -->
  <xacro:property name="drive_sprocket_diameter" value="0.065"/>
  <xacro:property name="drive_shaft_height" value="0.050"/>
  <xacro:property name="drive_shaft_diameter" value="0.006"/>

  <!-- Encoder calibration -->
  <xacro:property name="left_counts_per_rev" value="3303.0"/>
  <xacro:property name="right_counts_per_rev" value="3241.0"/>

  <!--
    Notes:
      - Drive joints below are logical joints used by ros2_control.
      - They represent the left and right tracked drivetrain sides.
      - Exact visual sprocket/track geometry is not required for odometry.
      - Encoder counts/revolution are initial measured calibration values
        and will be refined during floor odometry testing.
  -->

  <!-- ========================================================= -->
  <!-- Robot reference frames                                    -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>

  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Logical drivetrain joints                                 -->
  <!-- ========================================================= -->

  <!--
    These links/joints represent the two tracked drivetrain sides
    for ros2_control and differential-drive odometry.

    Their transforms are logical references only. The actual
    differential-drive geometry is configured using the measured
    track separation and drive sprocket radius.
  -->

  <link name="left_drive_link"/>

  <joint name="left_drive_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_drive_link"/>
    <origin xyz="0 ${track_separation / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_drive_link"/>

  <joint name="right_drive_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_drive_link"/>
    <origin xyz="0 ${-track_separation / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- LiDAR reference frame                                     -->
  <!-- ========================================================= -->

  <!--
    RPLIDAR A1 scan frame.

    Measured position relative to base_link:
      X = +0.0975 m  (forward)
      Y = +0.0350 m  (left)
      Z = +0.3640 m  (up)

    LiDAR yaw = +90 degrees, verified against the physical
    robot orientation in RViz.
  -->

  <link name="laser"/>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.0975 0.035 0.364" rpy="0 0 1.5708"/>
  </joint>

  <!-- ========================================================= -->
  <!-- ros2_control hardware                                     -->
  <!-- ========================================================= -->

  <ros2_control name="LionBotSystem" type="system">

    <hardware>
      <plugin>lionbot_hardware/LionBotSystemHardware</plugin>

      <param name="serial_port">/dev/serial/by-id/usb-Arduino_UNO_R4_Minima_38020C2B363136372B0C33334B572F2B-if00</param>

      <param name="left_counts_per_rev">${left_counts_per_rev}</param>
      <param name="right_counts_per_rev">${right_counts_per_rev}</param>
    </hardware>

    <!-- LEFT tracked drivetrain -->
    <joint name="left_drive_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>

    <!-- RIGHT tracked drivetrain -->
    <joint name="right_drive_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>

  </ros2_control>

</robot>
